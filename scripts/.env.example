# Copy to .env (or export in your shell) — NEVER commit the real value.
# The team's live connection string lives at /home/team/shared/.neon-db-url
# on the work machine (chmod 600). In GitHub Actions it's supplied as the
# DATABASE_URL repository secret (see .github/workflows/lead-sweep.yml).
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Phase 3: LinkedIn outreach (linkedin-outreach.js) ---
# Real mode REQUIRES credentials via env or a saved session — never in code.
# No credentials exist yet (owner hasn't decided automated vs manual), so the
# machine runs dry-run by default. NEVER commit real values.
# LINKEDIN_EMAIL=you@example.com
# LINKEDIN_PASSWORD=your-password
# LINKEDIN_SESSION_DIR=/path/to/saved-browser-session   # alternative: log in
#                                                       # once by hand, reuse
# LINKEDIN_DAILY_CAP=15        # hard daily cap override (default from config)
# LINKEDIN_DRY_RUN=1           # kill switch: forces dry-run, always
# LINKEDIN_STATE_FILE=/path/to/state.json   # per-day cap state (default:
#                                           # scripts/.linkedin-run-state.json)
# --- Phase 4: AI personalization + negotiation (scripts/ai.js) ---
# Optional. Without this key the machine uses the deterministic templates /
# canned replies — everything works, just not personalized. The owner's real
# key is a business secret: set it in the environment (or n8n/CI secrets),
# NEVER commit it. Used only in REAL outreach mode; dry-run never calls the
# API (fast, free, stable previews). DeepSeek bills per token — see README
# cost note.
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# --- Phase 5: Stripe payments (scripts/stripe-webhook.js, scripts/payment.js) ---
# Webhook signing secret from the Stripe dashboard (Developers → Webhooks →
# your endpoint → "Signing secret", whsec_...). Every /webhook/stripe request
# MUST carry a valid Stripe-Signature header or it is rejected 400. This is a
# business secret — env-only, NEVER commit.
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: signature timestamp tolerance in seconds (Stripe default 300).
# STRIPE_WEBHOOK_TOLERANCE_SEC=300
# Payment-link buy URLs, one per product (Stripe Dashboard → Payment Links).
# payment.js appends ?client_reference_id=<leadId> to whichever URL is chosen
# so the webhook can resolve the paying lead. STRIPE_PAYMENT_LINK_DEFAULT is
# the fallback for unmapped products. Static URLs — not secret, but keep them
# env-only for consistency.
# STRIPE_PAYMENT_LINK_PREMIUM_SITE=https://buy.stripe.com/xxxxxxxx
# STRIPE_PAYMENT_LINK_STARTER_SITE=https://buy.stripe.com/yyyyyyyy
# STRIPE_PAYMENT_LINK_AI_RECEPTIONIST=https://buy.stripe.com/zzzzzzzz
# STRIPE_PAYMENT_LINK_DEFAULT=https://buy.stripe.com/aaaaaaaa
