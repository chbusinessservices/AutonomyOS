# Copy to .env (or export in your shell) — NEVER commit the real value.
# The team's live connection string lives at /home/team/shared/.neon-db-url
# on the work machine (chmod 600). In GitHub Actions it's supplied as the
# DATABASE_URL repository secret (see .github/workflows/lead-sweep.yml).
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Phase 3: LinkedIn outreach (linkedin-outreach.js) ---
# Real mode REQUIRES credentials via env or a saved session — never in code.
# No credentials exist yet (owner hasn't decided automated vs manual), so the
# machine runs dry-run by default. NEVER commit real values.
# LINKEDIN_EMAIL=you@example.com
# LINKEDIN_PASSWORD=your-password
# LINKEDIN_SESSION_DIR=/path/to/saved-browser-session   # alternative: log in
#                                                       # once by hand, reuse
# LINKEDIN_DAILY_CAP=15        # hard daily cap override (default from config)
# LINKEDIN_DRY_RUN=1           # kill switch: forces dry-run, always
# LINKEDIN_STATE_FILE=/path/to/state.json   # per-day cap state (default:
#                                           # scripts/.linkedin-run-state.json)
